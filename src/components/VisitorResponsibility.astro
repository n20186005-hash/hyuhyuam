---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const v = messages.visitorResponsibility ?? {};
const science = v.science ?? [];
const duties = v.duties ?? [];
---

<section id="responsibility" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{v.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{v.subtitle}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <!-- 科普 -->
      <div>
        <h3 class="font-semibold text-xl mb-4" style="color: var(--text-primary);">{v.scienceTitle}</h3>
        <div class="space-y-4">
          {science.map((item) => (
            <article class="rounded-2xl border p-5" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
              <h4 class="flex items-center gap-2 font-semibold mb-2" style="color: var(--text-primary);">
                <span class="text-xl" aria-hidden="true">{item.icon}</span>
                {item.title}
              </h4>
              <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.text}</p>
            </article>
          ))}
        </div>
      </div>

      <!-- 访客责任 -->
      <div>
        <h3 class="font-semibold text-xl mb-4" style="color: var(--text-primary);">{v.dutyTitle}</h3>
        <ul class="space-y-3">
          {duties.map((item) => (
            <li class="rounded-2xl border p-5" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
              <p class="flex items-center gap-2 font-semibold text-sm mb-1" style="color: var(--text-primary);">
                <span class="text-lg" aria-hidden="true">{item.icon}</span>
                {item.title}
              </p>
              <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.text}</p>
            </li>
          ))}
        </ul>

        <div class="rounded-2xl border p-6 mt-5" style="background: color-mix(in srgb, var(--accent) 10%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, transparent);">
          <h4 class="font-semibold mb-2" style="color: var(--text-primary);">{v.pledgeLabel}</h4>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{v.pledgeText}</p>
        </div>
      </div>
    </div>
  </div>
</section>
